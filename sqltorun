ALTER TABLE admin_users
ADD COLUMN microsoft_oid VARCHAR(128) NULL,
ADD COLUMN auth_provider VARCHAR(50) NULL DEFAULT 'local',
ADD COLUMN sso_email VARCHAR(255) NULL,
ADD COLUMN last_sso_login_at DATETIME NULL;

ALTER TABLE admin_users
ADD UNIQUE KEY uq_admin_users_microsoft_oid (microsoft_oid);

CREATE TABLE IF NOT EXISTS user_groups (
    id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT NOT NULL,
    group_id INT NOT NULL,
    source VARCHAR(50) NOT NULL DEFAULT 'self_selected',
    status VARCHAR(50) NOT NULL DEFAULT 'pending',
    is_primary TINYINT(1) NOT NULL DEFAULT 1,
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,

    UNIQUE KEY uq_user_group (user_id, group_id),
    INDEX idx_user_groups_user_id (user_id),
    INDEX idx_user_groups_group_id (group_id),
    INDEX idx_user_groups_status (status)
);
ALTER TABLE group_contacts
    ADD COLUMN contact_number VARCHAR(50) NULL,
    ADD COLUMN scout_role VARCHAR(150) NULL,
    ADD COLUMN about_me TEXT NULL,
    ADD COLUMN accreditations TEXT NULL,
    ADD COLUMN share_contact_number TINYINT(1) NOT NULL DEFAULT 0,
    ADD COLUMN profile_updated_at DATETIME NULL;

    CREATE INDEX idx_group_contacts_group_id ON group_contacts (group_id);
CREATE INDEX idx_group_contacts_email ON group_contacts (email);
CREATE INDEX idx_group_contacts_full_name ON group_contacts (full_name);
